using System.Collections;
using System.Collections.Generic;
using UnityEngine;

[RequireComponent(typeof(CharacterController))]

public class CharacterMovement : MonoBehaviour
{
    [Header("Character movement stats")]
    [SerializeField] private float _moveSpeed;
    [SerializeField] private float _rorateSpeed;

    [Header("Jump screapt")]
    [SerializeField] CharacterJumpHendler jumpScript;


    [Header("Gravity handing")]
    [SerializeField] private float _gravityForce = 9.8f;

    public float GravityForce
    {
        set
        {
            if (value >= 0)
                _gravityForce = value;
        }
    }

    //  private float _currentAttractionCharacter = 0;

    [Header("Character components")]
    private CharacterController _characterController;
    [HideInInspector] public Vector3 velocityDirection;
    //internal object velocityDirection;

    void Start()
    {
        _characterController = GetComponent<CharacterController>();
    }

    void Update()
    {
        if (Input.GetKeyDown(KeyCode.Space))
        {
            if (jumpScript != null)
            {
                jumpScript.HandleJump();
            }
        }

        GravityHandling();
    }

    public void RotateCharacter(Vector3 moveDirection)
    {
        if (_characterController.isGrounded)
        {
            if (Vector3.Angle(transform.forward, moveDirection) > 0)
            {
                Vector3 newDirection = Vector3.RotateTowards(transform.forward, moveDirection, _rorateSpeed, 0);
                transform.rotation = Quaternion.LookRotation(newDirection);
            }
        }
    }
    public void MoveCharacter(Vector3 moveDirection)
    {
        velocityDirection.x = moveDirection.x * _moveSpeed;
        velocityDirection.z = moveDirection.z * _moveSpeed;
        _characterController.Move(velocityDirection * Time.deltaTime);
    }


    private void GravityHandling()
    {
        if (!_characterController.isGrounded)
            velocityDirection.y -= _gravityForce * Time.deltaTime;
    }
}
